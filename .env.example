# Environment Variables Example File
# Copy this file to .env.local and fill in the actual values.
# .env.local is ignored by git so your keys stay safe.

# Database
MONGODB_URI="mongodb+srv://..."

# Authentication
JWT_SECRET="your_secret_here"

# AI Tools (Graphify)
# Required for your AI coding assistants (Gemini, Copilot, etc.) to understand the project architecture.
GEMINI_API_KEY="your_gemini_api_key_here"
